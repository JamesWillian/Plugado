<?xml version="1.0" encoding="utf-8"?>
<!--
    Regras de backup (Android 12+). Os dados de escuta não vão pra nuvem do Google: o
    allowBackup="false" do manifest já desliga isso, e o cloud-backup abaixo deixa explícito,
    caso alguém religue o allowBackup no futuro.
    A cópia direta de um celular pro outro (cabo ou Wi-Fi, sem passar pela nuvem) continua
    levando tudo. Pra bloquear também, adicione um <device-transfer> com as mesmas exclusões.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
