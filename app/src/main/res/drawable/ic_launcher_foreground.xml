<?xml version="1.0" encoding="utf-8"?>
<!--
  Camada da frente do ícone adaptativo (108 dp, dos quais 72 aparecem): o ic_plugado com 1/6 de
  margem em cada lado, que deixa ele exatamente na área visível. Também é a camada monocromática
  (ícones temáticos do Android 13+). Margem em fração, pra escalar junto em qualquer tamanho.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_plugado"
    android:inset="16.666667%" />
