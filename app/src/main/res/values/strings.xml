    <!-- Privacidade -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_intro">Plugado measures your headphone time without invading your privacy. In short:</string>
    <string name="privacy_records_title">What Plugado records</string>
    <string name="privacy_records_body">When sound plays through your headphones, for how long and at which system volume. It also keeps the names of the headphones and speakers you connected.</string>
    <string name="privacy_not_title">What it doesn\'t do</string>
    <string name="privacy_not_body">It doesn\'t record audio, doesn\'t know which app or song is playing and doesn\'t use the internet.</string>
    <string name="privacy_where_title">Where your data lives</string>
    <string name="privacy_where_body">Only on this phone, with no cloud and no Google backup. If you move your apps to a new phone, your history goes with them.</string>
    <string name="privacy_control_title">You\'re in control</string>
    <string name="privacy_control_body">Pause whenever you want and erase everything in Settings › Delete all data.</string>
    <string name="privacy_full_policy">Read the full policy</string>
    <string name="privacy_updated">Updated October 2026</string>

