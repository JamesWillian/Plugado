    <string name="privacy_not_body">No graba audio, no sabe qué app o canción está sonando y no usa internet.</string>
    <string name="privacy_where_title">Dónde quedan tus datos</string>
    <string name="privacy_where_body">Solo en este teléfono, sin nube y sin copia de seguridad de Google. Si pasas tus apps a un teléfono nuevo, el historial va con ellas.</string>
